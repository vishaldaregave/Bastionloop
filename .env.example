# DEVELOPMENT ONLY.
# These credentials are public demo values. They are rejected when
# BASTION_ENV=production. Never reuse them for a deployed arena.

BASTION_ENV=development
BASTION_RUNTIME=docker
BASTION_ADMIN_TOKEN=dev-admin-token
BASTION_INTERNAL_TOKEN=dev-internal-token
BASTION_ALLOW_KEY_GEN=1
BASTION_ALLOW_NAIVE=1
BASTION_ALLOW_TAMPER=1
BASTION_ALLOW_JUDGE=1
BASTION_GATEWAY_IMAGE_DIGEST=sha256:dev-local-gateway
BASTION_CORS_ORIGINS=

# Optional
# BASTION_MODEL_ADAPTER=mock
# BASTION_MODEL_ID=mock-1b-instruct
# BASTION_CHECKPOINT_EVERY=4
# BASTION_PADDING_MS=120
