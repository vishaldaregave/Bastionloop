# PRODUCTION TEMPLATE — copy to .env and replace every placeholder.
# Generate secrets with: openssl rand -hex 32
# The gateway and services refuse to start if credentials are missing,
# short, equal to each other, or contain demo/placeholder values.

BASTION_ENV=production
BASTION_RUNTIME=docker

# Required: 32+ characters, high entropy, different from each other.
BASTION_ADMIN_TOKEN=REPLACE_WITH_64_CHAR_HEX_ADMIN_SECRET
BASTION_INTERNAL_TOKEN=REPLACE_WITH_64_CHAR_HEX_INTERNAL_SECRET

# Production disables all demo switches; these must remain 0.
BASTION_ALLOW_KEY_GEN=0
BASTION_ALLOW_NAIVE=0
BASTION_ALLOW_TAMPER=0
BASTION_ALLOW_JUDGE=0

# Required: the digest of the gateway image that produced the evidence.
BASTION_GATEWAY_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_IMAGE_DIGEST

# Same-origin web is used in Compose; leave empty unless a separate origin is required.
BASTION_CORS_ORIGINS=

# Optional
# BASTION_MODEL_ADAPTER=ollama
# BASTION_MODEL_ID=llama3.2:1b
# BASTION_CHECKPOINT_EVERY=4
# BASTION_PADDING_MS=120
